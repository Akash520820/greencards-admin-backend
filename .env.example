# ==============================================================================
# 🛠️ GreenCard — Admin Microservice Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5003
ADMIN_SERVICE_PORT=5003

# MongoDB Atlas admin_db connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/admin_db?retryWrites=true&w=majority

STAFF_ACCESS_TOKEN_SECRET=your_staff_jwt_access_secret
STAFF_REFRESH_TOKEN_SECRET=your_staff_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

INTERNAL_API_SECRET=your_internal_cluster_shared_secret

USER_BACKEND_INTERNAL_URL=https://greencards-user-backend.onrender.com
SELLER_BACKEND_INTERNAL_URL=https://greencards-seller-backend.onrender.com
SUPERADMIN_BACKEND_INTERNAL_URL=https://greencards-superadmin-backend.onrender.com
